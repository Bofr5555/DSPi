# Alink bench host tool (bench.py): Python 3 standard library in a venv, no
# packages installed, no network at build or run time.  The same official
# image as Containerfile, pinned by digest.
#   podman build -t dspi-alink-bench:1 -f Containerfile.bench .
FROM docker.io/library/python:3.12-slim@sha256:2b4f19dae3a777dfc3b76730bda1e82e1f66ab2a2686fa93ca78edbfb4f04ffe
RUN python3 -m venv --without-pip /opt/venv
WORKDIR /work/tools/alink
ENV PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["/opt/venv/bin/python", "-I", "bench.py"]
