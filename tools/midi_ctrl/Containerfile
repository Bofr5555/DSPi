# DSPi MIDI control host tool: Python 3 standard library only, nothing else
# is installed.  Official Docker Hub image, pinned by digest.
#   podman build -t dspi-midi-ctrl -f Containerfile .
FROM docker.io/library/python:3.12-slim@sha256:2b4f19dae3a777dfc3b76730bda1e82e1f66ab2a2686fa93ca78edbfb4f04ffe
WORKDIR /work/tools/midi_ctrl
ENV PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python3", "-I"]
