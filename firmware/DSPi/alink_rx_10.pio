; link_rx_10.pio; DSPi audio link NRZ receiver, class L2, 30.72 MBd (SYS2 2.6)
;
; Same structure as link_rx_20.pio (read that header first), scaled to 10
; sys cycles per line bit: the counter loop runs 3 polls instead of 8 and
; the entry delay is 4 (first emit 6 cycles after the poll that saw an edge).
;
; Bit grid, cycles relative to an emit (both paths):
;   0 emit | 1, 2 poll | 3 reload | 4, 6, 8 poll (counter loop) | 10 emit
; The poll at 8 decides the bit emitted at 10 (the effective sampling
; instant, half a bit after the anchoring edge); nominal edges sit at +3,
; between the polls at 2 and 4, so the re-phase quantisation is 2 cycles
; (6.5 ns, i.e. +-3.3 ns) and the edge window is +-4 cycles (+-13 ns).
;
; Setup: as link_rx_20.pio. DMA drains one word per 320 cycles.

.program link_rx_10
.define ENTRY_DELAY 4

.wrap_target
lo_top:                         ; line LOW: watch for a rise
    set x, 2                    ; 3 counter-loop polls (cycles 4, 6, 8)
lo_poll:
    jmp pin hi_entry            ; rose
    jmp x-- lo_poll
public lo_emit:
    in null, 1                  ; emit 0
    jmp pin hi_entry
    jmp pin hi_entry
.wrap
public hi_entry:
    jmp hi_emit [ENTRY_DELAY]   ; rose at the previous cycle
hi_top:                         ; line HIGH: watch for a fall
    set x, 2
hi_poll:
    jmp pin hi_cont             ; still high
    jmp lo_emit [ENTRY_DELAY]   ; fell
hi_cont:
    jmp x-- hi_poll
public hi_emit:
    in osr, 1                   ; emit 1
    jmp pin hi_p2
    jmp lo_emit [ENTRY_DELAY]   ; fell
hi_p2:
    jmp pin hi_top
    jmp lo_emit [ENTRY_DELAY]   ; fell
