; alink_rx_20.pio; DSPi audio link NRZ receiver, class L1, 15.36 MBd (SYS2 2.6)
;
; 20 sys cycles per line bit at clock divider 1.0 (307.2 MHz). Emits exactly
; one bit per line bit: the LEVEL the program believes the line has (a
; constant per path, never a pin read, so a late edge can never produce a
; bit that disagrees with the path it was emitted from). Every detected
; transition re-anchors the bit grid: the first bit of the new level is
; emitted 11 cycles after the poll that saw the edge, then every 20 cycles
; while the line holds.
;
; Bit grid, cycles relative to an emit (both paths):
;   0 emit | 1, 2 poll | 3 reload | 4, 6, ... 18 poll (counter loop) | 20 emit
; The bit emitted at 20 is decided by the poll at 18 (no edge seen by then),
; so that poll is the effective sampling instant; it lands half a bit after
; the edge that anchored the grid, and nominal edges sit at +8, on a poll.
; Polls are 2 cycles apart except for the 3-cycle gap just after the
; sampling instant, half a bit from any nominal edge. Re-phase quantisation:
; 2 cycles (6.5 ns); the window for an edge is +-9 cycles (+-29 ns) around
; nominal, less the quantisation of the edge that anchored the grid.
;
; Rise and fall are detected with equal latency: a rise takes `jmp pin` +
; hi_entry, a fall takes the not-taken `jmp pin` + the exit jump, both
; 2 instruction slots, both with ENTRY_DELAY, so the window is symmetric.
; A bench trim (tools/alink_rx_test, "case ... trim") moves delay between hi_entry and
; the three fall exits to centre the window on a transceiver's measured
; pulse-width distortion; the loader may patch those delay fields the same
; way (public labels hi_entry and lo_emit locate them).
;
; Setup: jmp_pin = the RX GPIO (input enabled, Schmitt on, RP2350 pad ISO
; cleared, input synchroniser kept), IN shift left (MSB first), autopush 32,
; RX FIFO join, clkdiv 1.0, start at the wrap target, then exec
; `mov osr, ~null` so `in osr, 1` emits a 1. No out/set/side-set pins, no
; Y. A DMA channel drains the RX FIFO into a ring; an autopush into a full
; FIFO would stall the program and slip bits, which the DMA rate (one word
; per 640 cycles here) never allows.
;
; A dark or stuck line emits a constant level every 20 cycles: the parser
; sees no commas and reports loss, as with the ADAT decoder.
;
; tools/alink_rx_test models this program cycle by cycle against the TX
; program, clock offset, pulse-width distortion and jitter.

.program alink_rx_20
.define ENTRY_DELAY 9

.wrap_target
lo_top:                         ; line LOW: watch for a rise
    set x, 7                    ; 8 counter-loop polls (cycles 4..18)
lo_poll:
    jmp pin hi_entry            ; rose
    jmp x-- lo_poll
public lo_emit:
    in null, 1                  ; emit 0
    jmp pin hi_entry            ; cycles 1, 2: keep polling through the
    jmp pin hi_entry            ; reload, fall through to lo_top
.wrap
public hi_entry:
    jmp hi_emit [ENTRY_DELAY]   ; rose at the previous cycle
hi_top:                         ; line HIGH: watch for a fall
    set x, 7
hi_poll:
    jmp pin hi_cont             ; still high
    jmp lo_emit [ENTRY_DELAY]   ; fell
hi_cont:
    jmp x-- hi_poll
public hi_emit:
    in osr, 1                   ; emit 1
    jmp pin hi_p2
    jmp lo_emit [ENTRY_DELAY]   ; fell
hi_p2:
    jmp pin hi_top
    jmp lo_emit [ENTRY_DELAY]   ; fell
